# Secrets — never commit
.env
.env.*
!.env.example
*.bak

# Personal config — kept local; copy the *.example.* templates and edit.
# The *.example.* files ARE committed (they're the templates everyone shares).
config/config.yaml
config/budgets.yaml
config/account_map.json
config/*.bak

# Plaid sync state & fetched data
config/cursor.txt
config/cursors.json
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Generated dashboards (contain financial data)
dashboard.html
dashboard_sample.html

# Scheduled-run logs
logs/
