# Copy to .env and fill in. Never commit the real .env.
PLAID_HOST=https://production.plaid.com
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret

# One access token per card LOGIN (per Plaid "item").
# The names here must match access_token_env in config.yaml.
PLAID_ACCESS_TOKEN=your_first_login_token
# PLAID_TOKEN_CHASE=your_second_login_token   # add when you link another bank

PLAID_ITEM_ID=your_item_id
NTFY_TOPIC="your-ntfy-topic"

# Passcode for the phone control panel (scripts/control_panel.py).
# Pick something long and unguessable. See docs/phone-access.md.
# CONTROL_PANEL_PASSCODE=change-me
